{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Minimum frontend permissions for the Live Downloader dashboard.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/daviblro/live-downloader/issues/new/choose"
        },
        {
          "url": "https://github.com/daviblro/live-downloader/releases/**"
        }
      ]
    }
  ]
}
